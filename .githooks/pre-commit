#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

FAILED=0

echo "Running pre-commit checks..."

# --- Python Linting (ruff) ---
STAGED_PY_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)

if [ -n "$STAGED_PY_FILES" ]; then
    if command -v ruff &> /dev/null; then
        echo -e "${YELLOW}Checking Python files with ruff...${NC}"

        if ! ruff check $STAGED_PY_FILES; then
            echo -e "${RED}ruff check failed. Run 'ruff check --fix' to auto-fix.${NC}"
            FAILED=1
        fi

        if ! ruff format --check $STAGED_PY_FILES; then
            echo -e "${RED}ruff format check failed. Run 'ruff format' to auto-fix.${NC}"
            FAILED=1
        fi

        if [ $FAILED -eq 0 ]; then
            echo -e "${GREEN}Python linting passed.${NC}"
        fi
    else
        echo -e "${YELLOW}ruff not found — skipping Python lint. Install with: pip install ruff${NC}"
    fi
else
    echo "No Python files staged — skipping Python lint."
fi

# --- CloudFormation Linting (cfn-lint) ---
STAGED_CFN_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '(deployment/.*\.yaml|aiml-security-assessment/template.*\.yaml)' || true)

if [ -n "$STAGED_CFN_FILES" ]; then
    if command -v cfn-lint &> /dev/null; then
        echo -e "${YELLOW}Checking CloudFormation templates with cfn-lint...${NC}"

        if ! cfn-lint $STAGED_CFN_FILES; then
            echo -e "${RED}cfn-lint failed.${NC}"
            FAILED=1
        else
            echo -e "${GREEN}CloudFormation linting passed.${NC}"
        fi
    else
        echo -e "${YELLOW}cfn-lint not found — skipping CFN lint. Install with: pip install cfn-lint${NC}"
    fi
else
    echo "No CloudFormation templates staged — skipping CFN lint."
fi

# --- Exit ---
if [ $FAILED -ne 0 ]; then
    echo -e "${RED}Pre-commit checks failed. Please fix the issues above.${NC}"
    exit 1
fi

echo -e "${GREEN}All pre-commit checks passed.${NC}"
